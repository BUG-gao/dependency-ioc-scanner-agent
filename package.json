{
  "name": "dependency-ioc-scanner-agent",
  "version": "1.0.0",
  "description": "CLI and openClaw skill adapter for scanning dependency IOC versions across project manifests.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ioc-scan": "dist/adapters/cli-adapter.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/adapters/cli-adapter.js",
    "dev": "tsx src/adapters/cli-adapter.ts",
    "prepare": "npm run build",
    "setup": "npm install && npm run build && npm link",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "semver": "^7.8.0",
    "toml": "^4.1.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
